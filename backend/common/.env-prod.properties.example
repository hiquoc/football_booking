# Copy to .env-prod.properties and update values for the Docker production stack.
# This file is safe to commit; the real .env-prod.properties file is ignored.

APP_MODE=PROD

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8080/ws
PRD_GATEWAY_BIND=0.0.0.0
PRD_GATEWAY_PORT=8080
PRD_FRONTEND_BIND=0.0.0.0
PRD_FRONTEND_PORT=80

POSTGRES_USER=football
POSTGRES_PASSWORD=football
POSTGRES_DB=football

JWT_SECRET=replace_with_base64_256_bit_or_longer_secret
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
INTERNAL_GATEWAY_SECRET=replace_with_long_random_internal_secret

USER_DB_URL=jdbc:postgresql://postgres:5432/user_db
USER_DB_USERNAME=football
USER_DB_PASSWORD=football
USER_SERVICE_URL=http://user-service:8081

FIELD_DB_URL=jdbc:postgresql://postgres:5432/field_db
FIELD_DB_USERNAME=football
FIELD_DB_PASSWORD=football
FIELD_SERVICE_URL=http://field-service:8082

BOOKING_DB_URL=jdbc:postgresql://postgres:5432/booking_db
BOOKING_DB_USERNAME=football
BOOKING_DB_PASSWORD=football

NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/notification_db
NOTIFICATION_DB_USERNAME=football
NOTIFICATION_DB_PASSWORD=football

PAYMENT_DB_URL=jdbc:postgresql://postgres:5432/payment_db
PAYMENT_DB_USERNAME=football
PAYMENT_DB_PASSWORD=football

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

SMTP_HOST=replace_me
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

N8N_URL=
N8N_KEY=

STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
